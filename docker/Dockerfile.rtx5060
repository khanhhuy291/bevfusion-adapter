# Runtime image for RTX 50-series / Blackwell.  Build
# docker/Dockerfile.rtx5060-deps first, then tag it as
# bevfusion-rtx5060-deps:latest.
FROM bevfusion-rtx5060-deps:latest

ENV DEBIAN_FRONTEND=noninteractive \
    FORCE_CUDA=1 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=2 \
    CUDA_HOME=/usr/local/cuda

WORKDIR /workspace/bevfusion-adapter

COPY . .
RUN mkdir -p data checkpoint runs

# Compile the repository's CUDA extensions specifically for sm_120.  Building
# in the image makes incompatibilities explicit before an inference container
# is started.
RUN python setup.py develop
# `docker build` does not expose the GPU.  Verify imports here; verify the
# actual sm_120 device after build with `docker run --gpus all`.
RUN python -c "import torch, mmcv, mmdet, mmdet3d; from mmdet3d.core import LiDARInstance3DBoxes; from mmdet3d.models import build_model; print(torch.__version__, torch.version.cuda, mmcv.__version__, mmdet.__version__)"

CMD ["/bin/bash"]
