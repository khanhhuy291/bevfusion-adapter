# Runtime image for RTX 50-series / Blackwell.  Build
# docker/Dockerfile.rtx5060-deps first, then tag it as
# bevfusion-rtx5060-deps:latest.
FROM bevfusion-rtx5060-deps:latest

ENV DEBIAN_FRONTEND=noninteractive \
    FORCE_CUDA=1 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=2 \
    CUDA_HOME=/usr/local/cuda

WORKDIR /workspace/bevfusion-adapter

COPY . .

# Compile the repository's CUDA extensions specifically for sm_120.  Building
# in the image makes incompatibilities explicit before an inference container
# is started.
RUN python setup.py develop
RUN python -c "import torch, mmcv, mmdet, mmdet3d; assert 'sm_120' in torch.cuda.get_arch_list(); print(torch.__version__, torch.version.cuda, mmcv.__version__, mmdet.__version__)"

CMD ["/bin/bash"]
